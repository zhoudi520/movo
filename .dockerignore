.git
.gitignore
.DS_Store

.env*
!.env.example
*.log

node_modules/
frontend/node_modules/
desktop/node_modules/
agent/node_modules/

backend/venv/
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

frontend/dist/
desktop/src-tauri/target/
agent/dist/

static/reports/
backend/static/reports/
backend/storage/*
tmp/
temp/

# document-parser image build uses repo root context; skip bulky offline base image tarballs
docker_base_images/*-img.tar.gz

# Gitignored Docling blobs must still be sent to the daemon (BuildKit honors .gitignore).
!docker_base_images/offline-docling-models/
!docker_base_images/offline-docling-models/**/*
